apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ plan.app_name }}
  namespace: {{ namespace }}
  labels:
    managed-by: idp-framework
spec:
  replicas: {{ plan.replicas }}
  selector:
    matchLabels:
      app: {{ plan.app_name }}
  template:
    metadata:
      labels:
        app: {{ plan.app_name }}
    spec:
      containers:
      - name: {{ plan.app_name }}
        image: {{ plan.image | default('nginx') }}
        ports:
        - containerPort: {{ plan.container_port | default(80) }}
        {% if plan.resources %}
        resources:
          requests:
            cpu: "{{ plan.resources.requests.cpu }}"
            memory: "{{ plan.resources.requests.memory }}"
          limits:
            cpu: "{{ plan.resources.limits.cpu }}"
            memory: "{{ plan.resources.limits.memory }}"
        {% endif %}
        volumeMounts:
        {% if plan.storage_gb %}
        - name: data-volume
          mountPath: /data
        {% endif %}
        {% if plan.config_data %}
        - name: config-volume
          mountPath: /etc/config # Files will appear here
        {% endif %}
      volumes:
      {% if plan.storage_gb %}
      - name: data-volume
        persistentVolumeClaim:
          claimName: {{ plan.app_name }}-pvc
      {% endif %}
      {% if plan.config_data %}
      - name: config-volume
        configMap:
          name: {{ plan.app_name }}-config
      {% endif %}