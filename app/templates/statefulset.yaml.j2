apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ plan.app_name }}
  namespace: {{ namespace }}
  labels:
    app: {{ plan.app_name }}
    managed-by: idp-framework
spec:
  serviceName: {{ plan.app_name }}-headless
  replicas: {{ plan.replicas }}
  selector:
    matchLabels:
      app: {{ plan.app_name }}
  template:
    metadata:
      labels:
        app: {{ plan.app_name }}
    spec:
      containers:
      - name: {{ plan.app_name }}
        image: {% if plan.image and plan.image != "None" and plan.image != "" %}{{ plan.image }}{% else %}nginx{% endif %}
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: {{ plan.container_port | default(80) }}
        {% if plan.secret_data %}
        envFrom:
        - secretRef:
            name: {{ plan.app_name }}-secret
        {% endif %}
        {% if plan.resources %}
        resources:
          requests:
            cpu: "{{ plan.resources.requests.cpu }}"
            memory: "{{ plan.resources.requests.memory }}"
          limits:
            cpu: "{{ plan.resources.limits.cpu }}"
            memory: "{{ plan.resources.limits.memory }}"
        {% endif %}
        volumeMounts:
        {% if plan.storage_gb %}
        - name: data
          mountPath: /data
        {% endif %}
        {% if plan.config_data %}
        - name: config-volume
          mountPath: /etc/config
        {% endif %}
      volumes:
      {% if plan.config_data %}
      - name: config-volume
        configMap:
          name: {{ plan.app_name }}-config
      {% endif %}
  {% if plan.storage_gb %}
  volumeClaimTemplates:
  - metadata:
      name: data
    spec:
      accessModes: ["ReadWriteOnce"]
      resources:
        requests:
          storage: {{ plan.storage_gb }}Gi
  {% endif %}
